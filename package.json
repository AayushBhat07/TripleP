{
  "name": "tender-automation-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev\" \"npm run api\"",
    "dev:web": "next dev",
    "api": "cd backend && python -m uvicorn proposalpanda.main:app --port 8000 --reload",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "cd backend && python -m pytest -q",
    "mock-ollama": "cd backend && python -m proposalpanda.scripts.mock_ollama",
    "db:create-admin": "cd backend && python -m proposalpanda.scripts.create_admin"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "mammoth": "^1.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
